# Copy to .env and fill in for local development.

# PostgreSQL connection string. Requires a running Postgres instance
# (PostGIS extension recommended per SPEC.md §7, not required for the scaffold).
DATABASE_URL="postgresql://mawa:mawa@localhost:5432/mawa?schema=public"

# Selects which set of provider implementations business logic is wired to.
# "sandbox" (default) -> Mock* providers (fake Fal numbers, simulated Ejar
# registration, simulated payments). "live" -> Live* providers, which are
# not implemented yet (see src/lib/providers/live/*) and will throw if
# constructed. A runtime guard additionally refuses to construct a Mock*
# provider when NODE_ENV=production and PROVIDER_MODE=live, so a sandbox
# record can never masquerade as a real one in production.
PROVIDER_MODE="sandbox"
